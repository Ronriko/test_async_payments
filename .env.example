# Template only: `cp .env.example .env` and fill in the empty secrets, e.g. `openssl rand -hex 32`
# (keep passwords URL-safe: they are put into connection strings as is). Nothing starts while
# a secret is empty.
API_KEY=

POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=

RABBITMQ_USER=payments
RABBITMQ_PASSWORD=

LOG_LEVEL=INFO
API_WORKERS=2
API_PORT=8000
RABBITMQ_MANAGEMENT_PORT=15672

# docker compose builds DATABASE_URL, TEST_DATABASE_URL and RABBITMQ_URL from the values above.
# Only for running the app or pytest on the host (see README, "Разработка"):
# DATABASE_URL=postgresql+asyncpg://payments:<password>@localhost:5432/payments
# TEST_DATABASE_URL=postgresql+asyncpg://payments:<password>@localhost:5432/payments_test
# RABBITMQ_URL=amqp://payments:<password>@localhost:5672/

# Optional tuning, defaults shown
# MAX_REQUEST_BODY_BYTES=65536
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# CONSUMER_PREFETCH=10
# MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_SECONDS=2.0
# GATEWAY_MIN_DELAY_SECONDS=2.0
# GATEWAY_MAX_DELAY_SECONDS=5.0
# GATEWAY_SUCCESS_RATE=0.9
# WEBHOOK_TIMEOUT_SECONDS=10
# true only for local receivers such as http://host.docker.internal:9000 (SSRF guard)
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# OUTBOX_BATCH_SIZE=100
# OUTBOX_POLL_INTERVAL_SECONDS=0.5
# OUTBOX_MAX_BACKOFF_SECONDS=60
# OUTBOX_RETENTION_HOURS=168
# PAYMENTS_EXCHANGE=payments
# PAYMENTS_QUEUE=payments.new
# DEAD_LETTER_EXCHANGE=payments.dlx
# DEAD_LETTER_QUEUE=payments.dlq
